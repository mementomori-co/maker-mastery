# Normalise line endings in the repository; check out with the right ending per type.
* text=auto

*.ps1  text eol=crlf
*.py   text eol=lf
*.md   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.json text eol=lf
*.html text eol=lf
*.svg  text eol=lf
*.txt  text eol=lf

# Binary files: never touch line endings or diff as text
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.zip  binary
*.3mf  binary
*.stl  binary
*.ttf  binary
*.woff binary
*.woff2 binary
