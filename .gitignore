# Python
.venv/
__pycache__/
*.pyc

# Scratch and build output
work/
dist/

# Log written by install\windows.ps1, macos.sh and linux.sh (your machine's details stay local)
install/install.log

# Your machine's settings and private lists (copy from the *.example files)
config/paths.yaml
config/denylist.txt
*.local.json
.claude/settings.local.json
.mcp.json
/OWNER_PROFILE.md

# Optional reviewer-chat handoff folder (your own plans and notes stay private)
plan/

# Print files: your own prints stay on your machine.
# Shipped examples under examples/ are allowed.
*.3mf
*.gcode
!examples/**/*.3mf
!examples/**/*.gcode
# The calibration cube STL is generated by examples/calibration-cube/make_cube.py; make it yourself, it is not shipped.
examples/calibration-cube/cube_20mm.stl

# Font files dropped in for rendering the brand images (not shipped)
assets/brand/src/fonts/

# Operating system clutter
.DS_Store
Thumbs.db
